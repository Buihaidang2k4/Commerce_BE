# Copy common secrets to .env; profile-specific settings to .env.dev / .env.prod.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DBMS_NAME=myshop
DBMS_CONNECTION=jdbc:mysql://localhost:3306/myshop
DBMS_USERNAME=root
DBMS_PASSWORD=root
MYSQL_ROOT_PASSWORD=root
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_TIMEOUT=5s
SPRING_CACHE_TYPE=redis
# HS512 requires at least 64 bytes; generate a random secret, do not use this placeholder.
JWT_SECRET=replace-with-random-secret-at-least-64-bytes
JWT_EXPIRATION=900000
JWT_REFRESHABLE_DURATION=604800000
PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
TMN_CODE=replace-with-merchant-code
SECRET_KEY=replace-with-vnpay-secret
RETURN_URL=http://localhost:8080/api/v1/payment/vn-pay-callback
VERSION=2.1.0
COMMAND=pay
ORDER_TYPE=other
EMAIL_USERNAME=replace-with-smtp-account
EMAIL_PASSWORD=replace-with-smtp-app-password
MINIO_ACCESS_KEY=replace-with-minio-user
MINIO_SECRET_KEY=replace-with-minio-password
MINIO_URL=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PRESIGN_EXPIRE_MINUTES=5
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_PAYMENT_RETURN_URL=http://localhost:3000/cart/checkout/order-confirmed/
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin123
BOOTSTRAP_ADMIN_PASSWORD=admin
SWAGGER_ENABLED=false
